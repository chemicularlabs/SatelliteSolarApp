# Copy to .env.local and fill in.

# Your Anthropic API key (console.anthropic.com). Never commit the real one.
ANTHROPIC_API_KEY=

# Which detector does the scanning:
#   claude = send each image to Claude (default)
#   mock   = return fake results, no API key or cost; for working on the UI
SCAN_DETECTOR=claude

# Optional: override the Claude model used by the claude detector.
# SCAN_MODEL=claude-opus-5-5
